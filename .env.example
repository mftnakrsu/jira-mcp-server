# ============================================================================
# JIRA MCP server — runtime env. Copy to `.env` next to docker-compose.yml and
# fill in real values. NEVER commit the real .env (it is gitignored).
# ============================================================================

# JIRA Data Center / Server base URL. Add the context path if served under one
# (e.g. https://jira.example.com/jira). A trailing slash is fine (stripped).
# For JIRA Cloud, use https://your-domain.atlassian.net instead.
JIRA_URL=https://jira.example.com

# READ-ONLY Personal Access Token (JIRA DC 8.14+ — NOT a Cloud API token).
JIRA_TOKEN=__SET_READ_ONLY_PAT__

# Leave EMPTY for the DC PAT path (Bearer / token_auth). Set a username ONLY for
# the Cloud email+API-token (basic_auth) path.
JIRA_USERNAME=

# false for internal self-signed certs (the InsecureRequestWarning is expected).
JIRA_VERIFY_SSL=false

# ---- optional ----
# Host port to publish (the container always listens on 8002):
# JIRA_MCP_PORT=8002
# Build-time pip index override (only if you build behind a corporate firewall
# and your internal mirror is missing a wheel):
# PIP_INDEX_URL=https://pypi.example.com/simple
